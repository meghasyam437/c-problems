#include<stdio.h>
int main() {
    int size;
    scanf("%d",&size);
    int arr[size];
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int largest=arr[0],second=arr[0];
    for(int i=0;i<size;i++){
        if(arr[i]>largest){
            second=largest;
        largest=arr[i];
    }
    
    else if(arr[i]>second&&arr[i]<largest){
        second=arr[i];
    }
    }
    printf("second:%d",second);
    return 0;
}
