#include <stdio.h>
int main() {
    int arr[100], n, i, element, found = 0;
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    printf("Enter the array elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    printf("Enter the element to delete: ");
    scanf("%d", &element);
    for(i = 0; i < n; i++) {
        if(arr[i] == element) {
            found = 1;
            for(int j = i; j < n - 1; j++) {
                arr[j] = arr[j + 1];
            }
            n--;
            break;
        }
    }
    if(found) {
        printf("Array after deletion:\n");
        for(i = 0; i < n; i++) {
            printf("%d ", arr[i]);
        }
    } else {
        printf("Element not found.");
    }
    return 0;
}
