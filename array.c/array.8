#include <stdio.h>
int main() {
    int n, k;
    printf("Enter number of shifts: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter shift values:\n");
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    printf("Enter K (number of days to rotate): ");
    scanf("%d", &k);
    int temp[k];
    for(int i = 0; i < k; i++) {
        temp[i] = arr[i];
    }
    for(int i = k; i < n; i++) {
        arr[i - k] = arr[i];
    }
    for(int i = 0; i < k; i++) {
        arr[n - k + i] = temp[i];
    }
    printf("Rotated array:\n");
    for(int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    return 0;
}
