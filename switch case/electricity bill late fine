#include <stdio.h>

int main() {
    int delayDays, fine = 0, category;

    scanf("%d %d",&category,&delayDays);

    if (delayDays <= 5)
        category = 1;
    else if (delayDays <= 10)
        category = 2;
    else
        category = 3;

    switch (category) {
        case 1:
            fine = delayDays * 50;
            break;
        case 2:
            fine = delayDays * 100;
            break;
        case 3:
            fine = delayDays * 200;
            break;
    }

    printf("Fine ₹%d", fine);
    return 0;
}
