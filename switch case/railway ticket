#include <stdio.h>

int main() {
int class;
int age;
int fare;
scanf("%d %d",&class,&age);
switch(class){
case 1:
fare=300;
if(age<12)
fare=fare*0.5;
else if(age>=60)
fare=fare*0.67;
break;
case 2:
fare=1000;
if(age<12)
fare=fare*0.5;
break;
default:
printf("invalid class");
break;
}
printf("%d",fare);
    return 0;
}
