#include <stdio.h>

int main() {
    int distancecategory, fee = 0;
    scanf("%d", &distancecategory);

    switch (distancecategory) {
        case 1:
            fee = 800;
            break;
        case 2:
            fee = 1200;
            break;
        case 3:
            fee = 1800;
            break;
        default:
            printf("Invalid category");
            return 0;
    }

    printf("%d", fee);
    return 0;
}
