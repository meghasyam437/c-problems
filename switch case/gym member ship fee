#include <stdio.h>

int main() {
    int durationType, month;
    scanf("%d %d", &durationType, &month);

    switch (durationType) {
        case 1:
            if (month == 1)
                printf("1500");
            break;

        case 2:
            if (month == 3)
                printf("4000");
            break;

        case 3:
            if (month == 6)
                printf("7000");
            break;

        default:
            printf("Invalid membership type");
    }

    return 0;
}

