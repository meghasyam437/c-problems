#include <stdio.h>
int main() {
    int capacity, N;
    scanf("%d", &capacity);
    scanf("%d", &N);
    int items[N];
    int totalStored = 0;
    int overflowDays = 0;
    for(int i = 0; i < N; i++) {
        scanf("%d", &items[i]);
        totalStored += items[i];
        if(totalStored > capacity) {
            overflowDays++;
        }
    }
    int remainingCapacity = capacity - totalStored;
    printf("Remaining Capacity: %d\n", remainingCapacity);
    printf("Overflow Days: %d\n", overflowDays);
    return 0;
}
