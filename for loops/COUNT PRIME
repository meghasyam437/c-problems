#include <stdio.h>
int main() {
  int i,n,j,count=0;
  int isprime;
  scanf("%d",&n);
  for(i=2;i<=n;i++){
    isprime =1;
    for(j=2;j<=i/2;j++){
        if(i%j==0){
            isprime=0;
            break;
        }
    }
  
if(isprime==1){
        count++;
}
  }
    printf("total prime numbers from 1 to %d=%d",n,count);
    return 0;
}
