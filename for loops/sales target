#include <stdio.h>

int main() {
    int n,daily_revenue;
    scanf("%d",&n);
    int total_revenue=0,target_days=0;
    for(int i=0;i<n;i++){
        scanf("%d",&daily_revenue);
        total_revenue+=daily_revenue;
        if(daily_revenue>50000)
        target_days++;

    }
    printf("%d %d",total_revenue,target_days);
    return 0;
}
