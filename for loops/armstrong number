#include <stdio.h>
#include <math.h>

int main() {
    int n, original, digit, sum = 0, count = 0;

    scanf("%d", &n);
    original = n;
    for (int temp = n; temp != 0; temp /= 10) {
        count++;
    }
    for (int temp = n; temp != 0; temp /= 10) {
        digit = temp % 10;
        sum += pow(digit, count);
    }
    if (sum == original)
        printf("Yes");
    else
        printf("No");

    return 0;
}
