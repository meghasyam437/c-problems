#include <stdio.h>

int main() {
    int n;

    scanf("%d", &n);

    int a[n];

    // Input elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Swap first and last elements
    int temp = a[0];
    a[0] = a[n - 1];
    a[n - 1] = temp;

    // Print array
    for (int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
