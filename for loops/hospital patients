#include <stdio.h>

int main() {
    int n,patients_perday;
    scanf("%d",&n);
    int total_patients=0,overcrowded_days=0;
    for(int i=0;i<n;i++){
        scanf("%d",&patients_perday);
        total_patients+=patients_perday;
        if(patients_perday>100)
        overcrowded_days++;
    }
    printf("%d %d",total_patients,overcrowded_days);
    return 0;
}
