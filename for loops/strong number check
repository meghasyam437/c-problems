#include <stdio.h>

int main() {
    int n,temp,digit,sum=0,fact;
    scanf("%d",&n);
    temp=n;
    while(n>0){
        digit=n%10;
        fact=1;
        for(int i=1;i<=digit;i++){
            fact*=i;
        }
        sum=sum+fact;
        n=n/10;
    }
    if(sum==temp)
    printf("yes");
    else
    printf("no");
    return 0;
}
