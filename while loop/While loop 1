#include <stdio.h>
int main() {
    int num, sum = 0, count = 0;
    printf("Enter numbers (0 to stop):\n");
    while (1) {
        scanf("%d", &num);
        if (num == 0) {
            break;
        }

        sum = sum + num;
        count++;
    }
    printf("Sum = %d\n", sum);
    printf("Count = %d\n", count);
    return 0;
}
