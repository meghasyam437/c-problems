#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);
    int a[n];
    int i = 0;
    while(i < n) {
        scanf("%d", &a[i]);
        i++;
    }
    int totalDrops = 0;
    int streak = 0;
    int crashDay = 0;
    i = 1;
    while(i < n) {
        if(a[i] < a[i-1]) {
            totalDrops++;
            streak++;
            if(streak == 3 && crashDay == 0) {
                crashDay = i + 1; 
            }
        } 
        else {
            streak = 0;
        }
        i++;
    }
    printf("Crash Day: %d\n", crashDay);
    printf("Total Drops: %d\n", totalDrops);
    return 0;
}
