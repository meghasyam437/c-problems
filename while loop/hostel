#include <stdio.h>
int main() {
    int capacity,n;
    scanf("%d %d",&capacity,&n);
    int i=0;
int finaloccupiedbeds=0,criticalhourcount=0; 
int change; 
float criticallimit=0.9*capacity;  
while(i<n){
scanf("%d",&change);
finaloccupiedbeds+=change;
if(finaloccupiedbeds<0)
finaloccupiedbeds=0;
if(finaloccupiedbeds>capacity)
finaloccupiedbeds=capacity;
if(finaloccupiedbeds>criticallimit)
criticalhourcount++;
i++;
}
printf("%d %d",finaloccupiedbeds,criticalhourcount);
    return 0;
}
