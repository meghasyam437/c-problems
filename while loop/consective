#include <stdio.h>
int main() {
  int N,i=1;  
 int arr[100];
 int drops=0,crashday=-1;
 int consecutive=0;
 printf("enter number of days:");
 scanf("%d",&N);
 printf("enter the index values:\n");
 int j=0;
 while(j<N)
 {
scanf("%d",&arr[j]);
j++;
 }
 while(i<N)
 {
if(arr[i]<arr[i-1])
{
drops++;
consecutive++;
if(consecutive==3&&crashday==-1)
{
    crashday=i+1;
}
}
else{
    consecutive=0;
}
i++;
}
if(crashday!=-1)
printf("crashday:%d\n",crashday);
else
printf("crashday:Not detected\n");
printf("totaldrops:%d\n",drops);
    return 0;
}
